# =====================================================
# KAM AIR PASSENGER PLATFORM BACKEND ENVIRONMENT VARIABLES
# =====================================================
# Instructions:
# 1. Duplicate this file and rename it to: .env
# 2. Configure your production database connection URL below.
# 3. If DATABASE_URL is empty, Django defaults to local SQLite.
# =====================================================

# DATABASE CONNECTION (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:YOUR_STRONG_PASSWORD@your-db-host.com:5432/postgres

# DJANGO PRODUCTION SETTINGS
SECRET_KEY=generate-a-strong-random-50-character-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=api.kamair.com,127.0.0.1,localhost

# CORS SETTINGS (Production origins)
CORS_ALLOWED_ORIGINS=https://fly.kamair.com,https://passenger.kamair.com,http://localhost:5173

# AI PASSENGER ASSISTANT GATEWAY (Optional LLM Integration)
OPENROUTER_API_KEY=
