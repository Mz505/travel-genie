# =====================================================
# TRAVEL GENIE BACKEND ENVIRONMENT VARIABLES
# =====================================================
# Instructions:
# 1. Duplicate this file and rename it to: .env
# 2. Paste your Supabase (or PostgreSQL) connection details below.
# 3. If you leave DATABASE_URL empty, Django will default to local SQLite.
# =====================================================

# DATABASE CONNECTION (Choose Option 1 or Option 2)

# Option 1 (Recommended): Single connection URL from Supabase
# Go to: Supabase Dashboard -> Project Settings -> Database -> Connection URI (Transaction or Session Pooler)
# Replace [YOUR-PASSWORD] with your actual database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Option 2: Individual Supabase fields (used only if DATABASE_URL is not set)
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.YOUR_PROJECT_ID
# SUPABASE_DB_PASSWORD=YOUR_PASSWORD
# SUPABASE_DB_HOST=aws-0-YOUR_REGION.pooler.supabase.com
# SUPABASE_DB_PORT=5432

# -----------------------------------------------------
# DJANGO SETTINGS
# -----------------------------------------------------
SECRET_KEY=django-insecure-travel-genie-student-project-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# -----------------------------------------------------
# AI INTEGRATION (Optional - OpenRouter API Key)
# -----------------------------------------------------
OPENROUTER_API_KEY=
